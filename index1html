    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
      (function () {
        "use strict";

        /* ---------- constants & palette ---------- */
        var N = 5000,
          GRID_W = 100,
          GRID_H = 50;
        var PALETTE = [
          [0.29, 0.871, 0.502], // emerald
          [0.176, 0.831, 0.749], // teal
          [0.22, 0.741, 0.973], // cyan
          [0.506, 0.549, 0.973], // indigo
          [0.655, 0.545, 0.98], // violet
        ];
        var REDUCED =
          window.matchMedia &&
          matchMedia("(prefers-reduced-motion: reduce)").matches;
        var jitterAmp = REDUCED ? 0.02 : 0.06;

        function lerp(a, b, t) {
          return a + (b - a) * t;
        }
        function clamp(v, a, b) {
          return Math.max(a, Math.min(b, v));
        }
        function smoothstep(t) {
          t = clamp(t, 0, 1);
          return t * t * (3 - 2 * t);
        }

        /* ---------- three.js scaffold ---------- */
        var canvas = document.getElementById("webgl");
        var renderer, scene, camera, points, geometry;
        var lineMesh, lineGeom;
        var webglOK = true;

        try {
          renderer = new THREE.WebGLRenderer({
            canvas: canvas,
            antialias: true,
            alpha: true,
          });
          renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
          renderer.setSize(window.innerWidth, window.innerHeight);

          scene = new THREE.Scene();
          scene.fog = new THREE.FogExp2(0x0a0b10, 0.045);

          camera = new THREE.PerspectiveCamera(
            58,
            window.innerWidth / window.innerHeight,
            0.1,
            100,
          );
          camera.position.set(0, 0, 10.5);

          var positions = new Float32Array(N * 3);
          var colors = new Float32Array(N * 3);
          geometry = new THREE.BufferGeometry();
          geometry.setAttribute(
            "position",
            new THREE.BufferAttribute(positions, 3),
          );
          geometry.setAttribute("color", new THREE.BufferAttribute(colors, 3));
          var material = new THREE.PointsMaterial({
            size: 0.065,
            vertexColors: true,
            transparent: true,
            opacity: 0.92,
            depthWrite: false,
            blending: THREE.AdditiveBlending,
            fog: true,
          });
          points = new THREE.Points(geometry, material);
          scene.add(points);

          lineGeom = new THREE.BufferGeometry();
          var lineMat = new THREE.LineBasicMaterial({
            color: 0x38bdf8,
            transparent: true,
            opacity: 0,
          });
          lineMesh = new THREE.LineSegments(lineGeom, lineMat);
          scene.add(lineMesh);
        } catch (e) {
          webglOK = false;
          document.body.classList.add("no-webgl");
        }

        /* ---------- seeds for idle jitter ---------- */
        var seeds = new Float32Array(N);
        for (var s = 0; s < N; s++) seeds[s] = Math.random() * Math.PI * 2;

        /* ---------- helpers to build base formations ---------- */
        function fillSphere(pos, col, start, end, cx, cy, cz, radius, color) {
          for (var i = start; i < end; i++) {
            var u = Math.random(),
              v = Math.random(),
              w = Math.random();
            var theta = u * Math.PI * 2,
              phi = Math.acos(2 * v - 1),
              r = radius * Math.cbrt(w);
            var x = cx + r * Math.sin(phi) * Math.cos(theta);
            var y = cy + r * Math.sin(phi) * Math.sin(theta);
            var z = cz + r * Math.cos(phi);
            pos[i * 3] = x;
            pos[i * 3 + 1] = y;
            pos[i * 3 + 2] = z;
            col[i * 3] = color[0];
            col[i * 3 + 1] = color[1];
            col[i * 3 + 2] = color[2];
          }
        }

        var basePos = [null],
          baseCol = [null]; // index 0 (hero) unused — computed live
        var chainCenters = [],
          scanCenters = [],
          stageCenters = [];

        (function buildFormations() {
          // k=1 gap — two clusters
          var p1 = new Float32Array(N * 3),
            c1 = new Float32Array(N * 3);
          fillSphere(p1, c1, 0, 2500, -3.1, 0, 0, 1.55, PALETTE[2]);
          fillSphere(p1, c1, 2500, 5000, 3.1, 0, 0, 1.55, PALETTE[4]);
          basePos[1] = p1;
          baseCol[1] = c1;

          // k=2 stages — 6 clusters in a ring
          var p2 = new Float32Array(N * 3),
            c2 = new Float32Array(N * 3);
          var per = Math.floor(N / 6),
            stageColors = [
              PALETTE[0],
              PALETTE[1],
              PALETTE[2],
              PALETTE[3],
              PALETTE[3],
              PALETTE[4],
            ];
          for (var si = 0; si < 6; si++) {
            var ang = si * ((Math.PI * 2) / 6) - Math.PI / 2;
            var cx = Math.cos(ang) * 4.2,
              cy = Math.sin(ang) * 4.2;
            stageCenters.push([cx, cy, 0]);
            var st = si * per,
              en = si === 5 ? N : (si + 1) * per;
            fillSphere(p2, c2, st, en, cx, cy, 0, 0.62, stageColors[si]);
          }
          basePos[2] = p2;
          baseCol[2] = c2;

          // k=3 feed — layered sine bands
          var p3 = new Float32Array(N * 3),
            c3 = new Float32Array(N * 3);
          for (var i3 = 0; i3 < N; i3++) {
            var layer = i3 % 5;
            var x3 = (i3 / N) * 13 - 6.5;
            var y3 =
              Math.sin(x3 * 1.15 + layer * 1.3) * 1.15 + (layer - 2) * 0.85;
            var z3 = (Math.random() - 0.5) * 1.1;
            p3[i3 * 3] = x3;
            p3[i3 * 3 + 1] = y3;
            p3[i3 * 3 + 2] = z3;
            var col = PALETTE[layer];
            c3[i3 * 3] = col[0];
            c3[i3 * 3 + 1] = col[1];
            c3[i3 * 3 + 2] = col[2];
          }
          basePos[3] = p3;
          baseCol[3] = c3;

          // k=4 cap bar — fill to 99% + cap line marker
          var p4 = new Float32Array(N * 3),
            c4 = new Float32Array(N * 3);
          var fillCount = Math.floor(N * 0.9);
          for (var i4 = 0; i4 < fillCount; i4++) {
            var t4 = Math.random();
            var x4 = (Math.random() - 0.5) * 1.4,
              z4 = (Math.random() - 0.5) * 1.4;
            var y4 = -3.1 + t4 * 5.9;
            p4[i4 * 3] = x4;
            p4[i4 * 3 + 1] = y4;
            p4[i4 * 3 + 2] = z4;
            var mix4 = lerp(0, 1, t4);
            var cA = PALETTE[2],
              cB = PALETTE[0];
            c4[i4 * 3] = lerp(cA[0], cB[0], mix4);
            c4[i4 * 3 + 1] = lerp(cA[1], cB[1], mix4);
            c4[i4 * 3 + 2] = lerp(cA[2], cB[2], mix4);
          }
          for (var i4b = fillCount; i4b < N; i4b++) {
            var x4b = (Math.random() - 0.5) * 2.8,
              z4b = (Math.random() - 0.5) * 0.6;
            p4[i4b * 3] = x4b;
            p4[i4b * 3 + 1] = 3.05;
            p4[i4b * 3 + 2] = z4b;
            c4[i4b * 3] = PALETTE[4][0];
            c4[i4b * 3 + 1] = PALETTE[4][1];
            c4[i4b * 3 + 2] = PALETTE[4][2];
          }
          basePos[4] = p4;
          baseCol[4] = c4;

          // k=5 chain — 8 linked blocks
          var p5 = new Float32Array(N * 3),
            c5 = new Float32Array(N * 3);
          var blocks = 8,
            per5 = Math.floor(N / blocks);
          for (var b = 0; b < blocks; b++) {
            var bx = -6.3 + b * (12.6 / (blocks - 1));
            chainCenters.push([bx, 0, 0]);
            var st5 = b * per5,
              en5 = b === blocks - 1 ? N : (b + 1) * per5;
            fillSphere(p5, c5, st5, en5, bx, 0, 0, 0.46, PALETTE[0]);
          }
          basePos[5] = p5;
          baseCol[5] = c5;

          // k=6 scan flow — 4 stage clusters
          var p6 = new Float32Array(N * 3),
            c6 = new Float32Array(N * 3);
          var flow = 4,
            per6 = Math.floor(N / flow),
            flowColors = [PALETTE[1], PALETTE[2], PALETTE[3], PALETTE[4]];
          for (var f = 0; f < flow; f++) {
            var fx = -5 + f * (10 / (flow - 1));
            scanCenters.push([fx, 0, 0]);
            var st6 = f * per6,
              en6 = f === flow - 1 ? N : (f + 1) * per6;
            fillSphere(p6, c6, st6, en6, fx, 0, 0, 0.72, flowColors[f]);
          }
          basePos[6] = p6;
          baseCol[6] = c6;

          // k=7 stats — broad ambient dispersed field
          var p7 = new Float32Array(N * 3),
            c7 = new Float32Array(N * 3);
          for (var i7 = 0; i7 < N; i7++) {
            var phi7 = Math.acos(1 - 2 * ((i7 + 0.5) / N));
            var th7 = Math.PI * (1 + Math.sqrt(5)) * (i7 + 0.5);
            var rr = 3 + Math.random() * 2.2;
            p7[i7 * 3] = Math.sin(phi7) * Math.cos(th7) * rr;
            p7[i7 * 3 + 1] = Math.sin(phi7) * Math.sin(th7) * rr * 0.55;
            p7[i7 * 3 + 2] = Math.cos(phi7) * rr * 0.7;
            var pc = PALETTE[i7 % 5];
            c7[i7 * 3] = pc[0] * 0.45;
            c7[i7 * 3 + 1] = pc[1] * 0.45;
            c7[i7 * 3 + 2] = pc[2] * 0.45;
          }
          basePos[7] = p7;
          baseCol[7] = c7;

          // k=8 cta — dense converging core
          var p8 = new Float32Array(N * 3),
            c8 = new Float32Array(N * 3);
          for (var i8 = 0; i8 < N; i8++) {
            var u8 = Math.random(),
              v8 = Math.random(),
              w8 = Math.random();
            var theta8 = u8 * Math.PI * 2,
              phi8 = Math.acos(2 * v8 - 1);
            var r8 = Math.pow(w8, 2.1) * 3.4;
            p8[i8 * 3] = r8 * Math.sin(phi8) * Math.cos(theta8);
            p8[i8 * 3 + 1] = r8 * Math.sin(phi8) * Math.sin(theta8);
            p8[i8 * 3 + 2] = r8 * Math.cos(phi8);
            var m8 = clamp(r8 / 3.4, 0, 1);
            c8[i8 * 3] = lerp(PALETTE[2][0], PALETTE[0][0], 1 - m8);
            c8[i8 * 3 + 1] = lerp(PALETTE[2][1], PALETTE[0][1], 1 - m8);
            c8[i8 * 3 + 2] = lerp(PALETTE[2][2], PALETTE[0][2], 1 - m8);
          }
          basePos[8] = p8;
          baseCol[8] = c8;
        })();

        /* ---------- hero (live webcam / procedural) ---------- */
        var video = document.getElementById("srcVideo");
        var sampleCanvas = document.getElementById("sampleCanvas");
        var sctx = sampleCanvas.getContext("2d", { willReadFrequently: true });
        var bgData = null;
        var useLiveVideo = false;

        function computeHeroLive(outPos, outCol) {
          sctx.drawImage(video, 0, 0, GRID_W, GRID_H);
          var data = sctx.getImageData(0, 0, GRID_W, GRID_H).data;
          for (var gy = 0; gy < GRID_H; gy++) {
            for (var gx = 0; gx < GRID_W; gx++) {
              var idx = gy * GRID_W + gx;
              var r = data[idx * 4],
                g = data[idx * 4 + 1],
                b = data[idx * 4 + 2];
              var diff = 0,
                lum = (r + g + b) / 765;
              if (bgData) {
                diff =
                  Math.abs(r - bgData[idx * 4]) +
                  Math.abs(g - bgData[idx * 4 + 1]) +
                  Math.abs(b - bgData[idx * 4 + 2]);
              }
              var depthFactor = clamp((diff - 40) / 200, 0, 1);
              var x = (0.5 - gx / GRID_W) * 9.2;
              var y = (0.5 - gy / GRID_H) * 6.2;
              var z = bgData ? -2.2 + depthFactor * 4.8 : (lum - 0.5) * 3.2;
              outPos[idx * 3] = x;
              outPos[idx * 3 + 1] = y;
              outPos[idx * 3 + 2] = z;
              var bright = bgData
                ? 0.12 + depthFactor * 0.88
                : 0.25 + lum * 0.6;
              var cy = PALETTE[2],
                wh = [0.9, 0.97, 1.0];
              var edgeMix = bgData ? depthFactor * 0.55 : lum * 0.3;
              outCol[idx * 3] = lerp(cy[0], wh[0], edgeMix) * bright;
              outCol[idx * 3 + 1] = lerp(cy[1], wh[1], edgeMix) * bright;
              outCol[idx * 3 + 2] = lerp(cy[2], wh[2], edgeMix) * bright;
            }
          }
        }

        function computeHeroProcedural(outPos, outCol, time) {
          for (var i = 0; i < N; i++) {
            var seed = seeds[i];
            var phi = Math.acos(1 - 2 * ((i + 0.5) / N));
            var th = Math.PI * (1 + Math.sqrt(5)) * (i + 0.5);
            var x = Math.sin(phi) * Math.cos(th),
              y = Math.sin(phi) * Math.sin(th),
              z = Math.cos(phi);
            var n =
              Math.sin(x * 3 + time * 0.3 + seed) *
              Math.cos(y * 3 - time * 0.22) *
              Math.sin(z * 3 + time * 0.26);
            var r = 2.5 + n * 0.55;
            outPos[i * 3] = x * r;
            outPos[i * 3 + 1] = y * r * 1.55;
            outPos[i * 3 + 2] = z * r;
            var m = clamp((y * 1.55 + 2.4) / 4.8, 0, 1);
            outCol[i * 3] = lerp(PALETTE[2][0], PALETTE[4][0], m);
            outCol[i * 3 + 1] = lerp(PALETTE[2][1], PALETTE[4][1], m);
            outCol[i * 3 + 2] = lerp(PALETTE[2][2], PALETTE[4][2], m);
          }
        }

        var heroPos = new Float32Array(N * 3),
          heroCol = new Float32Array(N * 3);
        computeHeroProcedural(heroPos, heroCol, 0);

        /* ---------- consent flow ---------- */
        var consent = document.getElementById("consent");
        var grantBtn = document.getElementById("grantBtn");
        var skipBtn = document.getElementById("skipBtn");
        var calibrating = document.getElementById("calibrating");

        function dismissConsent() {
          consent.classList.add("hidden");
        }

        skipBtn.addEventListener("click", dismissConsent);

        grantBtn.addEventListener("click", function () {
          if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            dismissConsent();
            return;
          }
          grantBtn.disabled = true;
          skipBtn.disabled = true;
          navigator.mediaDevices
            .getUserMedia({ video: { width: 320, height: 240 }, audio: false })
            .then(function (stream) {
              video.srcObject = stream;
              video.addEventListener(
                "loadedmetadata",
                function () {
                  calibrating.style.display = "block";
                  setTimeout(function () {
                    sctx.drawImage(video, 0, 0, GRID_W, GRID_H);
                    bgData = sctx
                      .getImageData(0, 0, GRID_W, GRID_H)
                      .data.slice();
                    useLiveVideo = true;
                    dismissConsent();
                  }, 1100);
                },
                { once: true },
              );
            })
            .catch(function () {
              dismissConsent();
            });
        });

        /* ---------- section-driven scroll mapping ---------- */
        var secEls = Array.prototype.slice.call(
          document.querySelectorAll(".panel"),
        );
        var centers = [];
        function computeCenters() {
          centers = secEls.map(function (el) {
            return el.offsetTop + el.offsetHeight / 2;
          });
        }
        computeCenters();
        window.addEventListener("resize", function () {
          computeCenters();
          if (renderer) {
            renderer.setSize(window.innerWidth, window.innerHeight);
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
          }
        });

        /* ---------- reveal-on-scroll for content ---------- */
        if ("IntersectionObserver" in window) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (en) {
                if (en.isIntersecting) en.target.classList.add("is-visible");
              });
            },
            { threshold: 0.32 },
          );
          secEls.forEach(function (el) {
            io.observe(el);
          });
        } else {
          secEls.forEach(function (el) {
            el.classList.add("is-visible");
          });
        }

        /* ---------- mouse parallax ---------- */
        var mouseX = 0,
          mouseY = 0,
          camX = 0,
          camY = 0;
        window.addEventListener("mousemove", function (e) {
          mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
          mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
        });

        /* ---------- render loop ---------- */
        var scratchAPos = new Float32Array(N * 3),
          scratchACol = new Float32Array(N * 3);
        var scratchBPos = new Float32Array(N * 3),
          scratchBCol = new Float32Array(N * 3);
        var lastLineIdx = -1;

        function computeFormation(k, time, outPos, outCol) {
          if (k === 0) {
            if (useLiveVideo) computeHeroLive(outPos, outCol);
            else computeHeroProcedural(outPos, outCol, time);
            return;
          }
          var bp = basePos[k],
            bc = baseCol[k];
          for (var i = 0; i < N; i++) {
            var sd = seeds[i];
            var jx = Math.sin(time * 0.42 + sd) * jitterAmp;
            var jy = Math.cos(time * 0.31 + sd * 1.7) * jitterAmp * 0.8;
            var jz = Math.sin(time * 0.23 + sd * 1.3) * jitterAmp * 0.8;
            outPos[i * 3] = bp[i * 3] + jx;
            outPos[i * 3 + 1] = bp[i * 3 + 1] + jy;
            outPos[i * 3 + 2] = bp[i * 3 + 2] + jz;
            outCol[i * 3] = bc[i * 3];
            outCol[i * 3 + 1] = bc[i * 3 + 1];
            outCol[i * 3 + 2] = bc[i * 3 + 2];
          }
        }

        function buildLinePairs(centersArr, close) {
          var arr = [];
          for (var i = 0; i < centersArr.length - 1; i++) {
            arr.push(centersArr[i][0], centersArr[i][1], centersArr[i][2]);
            arr.push(
              centersArr[i + 1][0],
              centersArr[i + 1][1],
              centersArr[i + 1][2],
            );
          }
          if (close && centersArr.length > 2) {
            arr.push(
              centersArr[centersArr.length - 1][0],
              centersArr[centersArr.length - 1][1],
              centersArr[centersArr.length - 1][2],
            );
            arr.push(centersArr[0][0], centersArr[0][1], centersArr[0][2]);
          }
          return new Float32Array(arr);
        }
        var lineSets = {
          2: buildLinePairs(stageCenters, true),
          5: buildLinePairs(chainCenters, false),
          6: buildLinePairs(scanCenters, false),
        };

        var tamperActive = false;

        var clock = webglOK ? new THREE.Clock() : null;

        function animate() {
          requestAnimationFrame(animate);
          if (!webglOK) return;
          var time = clock.getElapsedTime();

          var marker = window.scrollY + window.innerHeight * 0.5;
          var idx = 0;
          for (var k = 0; k < centers.length - 1; k++) {
            if (marker >= centers[k]) idx = k;
          }
          idx = Math.min(idx, centers.length - 2);
          var span = centers[idx + 1] - centers[idx];
          var local =
            span > 0 ? clamp((marker - centers[idx]) / span, 0, 1) : 0;
          var smooth = smoothstep(local);

          computeFormation(idx, time, scratchAPos, scratchACol);
          computeFormation(idx + 1, time, scratchBPos, scratchBCol);

          var posAttr = geometry.attributes.position.array;
          var colAttr = geometry.attributes.color.array;
          for (var i = 0; i < N * 3; i++) {
            posAttr[i] = lerp(scratchAPos[i], scratchBPos[i], smooth);
            colAttr[i] = lerp(scratchACol[i], scratchBCol[i], smooth);
          }

          // tamper effect on chain formation (idx window 5)
          if (tamperActive && (idx === 5 || idx + 1 === 5)) {
            for (var bIdx = 6 * Math.floor(N / 8); bIdx < N; bIdx++) {
              posAttr[bIdx * 3] += Math.sin(time * 9 + bIdx) * 0.12;
              posAttr[bIdx * 3 + 1] += Math.cos(time * 11 + bIdx) * 0.12;
              colAttr[bIdx * 3] = PALETTE[4][0];
              colAttr[bIdx * 3 + 1] = PALETTE[4][1] * 0.3;
              colAttr[bIdx * 3 + 2] = PALETTE[4][2] * 0.3;
            }
          }

          geometry.attributes.position.needsUpdate = true;
          geometry.attributes.color.needsUpdate = true;

          // structure lines (stage ring / chain / scan flow)
          var nearestIdx = Math.round(idx + smooth);
          var settle =
            1 - Math.min(1, Math.abs(idx + smooth - nearestIdx) * 3.2);
          if (lineSets[nearestIdx]) {
            if (nearestIdx !== lastLineIdx) {
              lineGeom.setAttribute(
                "position",
                new THREE.BufferAttribute(lineSets[nearestIdx], 3),
              );
              lastLineIdx = nearestIdx;
            }
            lineMesh.material.opacity = settle * 0.35;
          } else {
            lineMesh.material.opacity = 0;
            lastLineIdx = -1;
          }

          // camera motion: gentle autodrift + scroll dolly + mouse parallax
          camX = lerp(camX, mouseX * 0.7, 0.04);
          camY = lerp(camY, -mouseY * 0.5, 0.04);
          var drift = REDUCED ? 0 : Math.sin(time * 0.05) * 0.6;
          camera.position.x = camX + drift;
          camera.position.y =
            camY + (REDUCED ? 0 : Math.cos(time * 0.04) * 0.4);
          camera.position.z = 10.5 - idx * 0.15;
          camera.lookAt(0, 0, 0);

          renderer.render(scene, camera);
        }
        if (webglOK) animate();

        /* ================= DOM content & interactions ================= */

        /* stage cards */
        var STAGES = [
          {
            n: "01",
            name: "identity",
            c: "--emerald",
            q: "Is this agent allowed to do this at all?",
            ex: "withdraw is outside this agent’s grant",
          },
          {
            n: "02",
            name: "intent",
            c: "--teal",
            q: "Does its stated purpose match its objective?",
            ex: "stated purpose does not match the agent’s objective",
          },
          {
            n: "03",
            name: "policy",
            c: "--cyan",
            q: "Spending, exposure, frequency, counterparty.",
            ex: "₹82,000 is over the per-action cap",
          },
          {
            n: "04",
            name: "context",
            c: "--indigo",
            q: "Counterparty reputation, protocol risk, flags.",
            ex: "yield-max is unaudited",
          },
          {
            n: "05",
            name: "behaviour",
            c: "--indigo",
            q: "Is this how this agent actually behaves?",
            ex: "₹49,500 is 2.1σ above this agent’s usual",
          },
          {
            n: "06",
            name: "manipulation",
            c: "--violet",
            q: "Can the instruction behind it be trusted?",
            ex: "the instruction contains override of prior instructions",
          },
        ];
        var grid = document.getElementById("stageGrid");
        STAGES.forEach(function (s) {
          var el = document.createElement("div");
          el.className = "stage-card";
          el.style.setProperty("--stage-c", "var(" + s.c + ")");
          el.innerHTML =
            '<div class="num">' +
            s.n +
            "</div><h3>" +
            s.name +
            '</h3><p class="q">' +
            s.q +
            '</p><div class="ex">' +
            s.ex +
            "</div>";
          el.addEventListener("click", function () {
            el.classList.toggle("revealed");
          });
          grid.appendChild(el);
        });

        /* live feed */
        var FEED = [
          {
            v: "BLOCK",
            cls: "l-block",
            text: "wlt-9f2c41    ₹48,000   the instruction contains override of prior instructions",
          },
          {
            v: "CONSTRAIN",
            cls: "l-constrain",
            text: "delta-logi..  ₹82,000 -> ₹50,000   over the per-action cap",
          },
          {
            v: "VERIFY",
            cls: "l-verify",
            text: "northwind..   ₹9,400    first time sending to northwind-print",
          },
          { v: "ALLOW", cls: "l-allow", text: "acme-cloud    ₹11,240" },
        ];
        var feedOut = document.getElementById("feedOutput");
        var runFeedBtn = document.getElementById("runFeed");
        runFeedBtn.addEventListener("click", function () {
          runFeedBtn.disabled = true;
          feedOut.innerHTML = "";
          var i = 0;
          function next() {
            if (i >= FEED.length) {
              var summary = document.createElement("div");
              summary.className = "feed-line";
              summary.style.marginTop = "0.8em";
              summary.style.color = "var(--text-lo)";
              summary.textContent =
                "Decisions   264 allowed (95%)   2 step-up   1 constrained   11 blocked\nAutonomy    95.0% of actions proceeded with nobody asked";
              summary.style.whiteSpace = "pre";
              feedOut.appendChild(summary);
              runFeedBtn.disabled = false;
              return;
            }
            var f = FEED[i];
            var line = document.createElement("div");
            line.className = "feed-line " + f.cls;
            line.textContent = f.v.padEnd(10, " ") + f.text;
            feedOut.appendChild(line);
            i++;
            setTimeout(next, 420);
          }
          next();
        });

        /* trail verify / tamper */
        var trailStatus = document.getElementById("trailStatus");
        document
          .getElementById("verifyBtn")
          .addEventListener("click", function () {
            tamperActive = false;
            trailStatus.innerHTML =
              '<span class="l-ok">OK</span>      decisions-mtcnin36.json\n        278 decisions, chained and unbroken\n        signed 2026-08-28T07:49:52.870Z by key e960b577e03659b4';
          });
        document
          .getElementById("tamperBtn")
          .addEventListener("click", function () {
            tamperActive = true;
            trailStatus.innerHTML =
              '<span class="l-fail">FAILED</span>  tampered.json\n        entry 255 has been altered since it was written';
          });
        document
          .getElementById("resetTrailBtn")
          .addEventListener("click", function () {
            tamperActive = false;
            trailStatus.innerHTML = "";
          });

        /* scan money counter */
        var moneyEl = document.getElementById("moneyAtRisk");
        var scanSection = document.getElementById("scan");
        var scanDone = false;
        if ("IntersectionObserver" in window) {
          var scanIO = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (en) {
                if (en.isIntersecting && !scanDone) {
                  scanDone = true;
                  var start = null,
                    target = 8930000,
                    duration = 1600;
                  function step(ts) {
                    if (!start) start = ts;
                    var p = clamp((ts - start) / duration, 0, 1);
                    var val = Math.floor(target * (1 - Math.pow(1 - p, 3)));
                    moneyEl.textContent = "₹" + val.toLocaleString("en-IN");
                    if (p < 1) requestAnimationFrame(step);
                  }
                  requestAnimationFrame(step);
                }
              });
            },
            { threshold: 0.4 },
          );
          scanIO.observe(scanSection);
        }

        /* stat counters */
        var statDone = false;
        var statsSection = document.getElementById("stats");
        if ("IntersectionObserver" in window) {
          var statIO = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (en) {
                if (en.isIntersecting && !statDone) {
                  statDone = true;
                  document
                    .querySelectorAll("#statGrid .v[data-target]")
                    .forEach(function (el) {
                      var target = parseInt(el.getAttribute("data-target"), 10);
                      var suffix = el.getAttribute("data-suffix") || "";
                      var start = null,
                        duration = 1200;
                      function step(ts) {
                        if (!start) start = ts;
                        var p = clamp((ts - start) / duration, 0, 1);
                        el.textContent =
                          Math.floor(target * (1 - Math.pow(1 - p, 3))) +
                          suffix;
                        if (p < 1) requestAnimationFrame(step);
                      }
                      requestAnimationFrame(step);
                    });
                }
              });
            },
            { threshold: 0.35 },
          );
          statIO.observe(statsSection);
        }

        /* copy buttons */
        document.querySelectorAll(".copy-btn").forEach(function (btn) {
          btn.addEventListener("click", function () {
            var cmd = btn.getAttribute("data-cmd");
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(cmd).then(function () {
                var orig = btn.textContent;
                btn.textContent = "copied";
                setTimeout(function () {
                  btn.textContent = orig;
                }, 1400);
              });
            }
          });
        });
      })();
    </script>
  </body>
</html>
