# SIRIUS GUI Environment Configuration Reference
# Duplicate this file to .env or .env.development for local usage

# API Configuration
VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws/v1

# Environment Mode: 'development' | 'staging' | 'production'
VITE_APP_ENV=development

# Feature Flags & API Mode
# Set to 'true' to run with simulated in-browser Core API contracts during local development
VITE_USE_MOCK_API=true
