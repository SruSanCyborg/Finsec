# ── Sirius Line web client ────────────────────────────────────────────────────

# Leave NEXT_PUBLIC_API_URL empty to run fully in MOCK mode (no backend needed).
# Set it to your FastAPI Core API base URL (e.g. http://localhost:8000/api/v1) to go real.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Neon PostgreSQL is ONLY ever accessed by the FastAPI backend, never from this web client.
# The backend connection string lives in backend/.env (see backend/.env.example).

# Future self-learning AI model endpoint (leave empty until model is deployed)
NEXT_PUBLIC_AI_URL=

# ── Clerk authentication ──────────────────────────────────────────────────────
# The publishable key is safe for the browser. CLERK_SECRET_KEY is server-only
# (used by middleware to protect routes) and must never be shipped to the client.
# Create your instance + keys at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_aHVtYW5lLWdvbGRmaXNoLTk5NDMuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_T5hDOdVHgI3Oaj9kpq9teNdJG5m9vPKgQR08PVHPNp
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
