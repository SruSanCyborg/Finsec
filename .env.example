# ── Sirius web client ─────────────────────────────────────────────────────────

# Leave NEXT_PUBLIC_API_URL empty to run fully in MOCK mode (no backend needed).
# Set it to your backend base URL (e.g. http://localhost:8000/api/v1) to go real.
# NEXT_PUBLIC_BACKEND_URL is an alias used by the API client.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_WS_URL=

# Neon PostgreSQL is ONLY ever accessed by the backend, never from this client.
# The backend connection string lives in backend/.env (see backend/.env.example).

# ── Clerk authentication ──────────────────────────────────────────────────────
# The publishable key is safe for the browser. CLERK_SECRET_KEY is server-only
# (used by the backend to verify session tokens) and must never be shipped here.
# Create your instance + keys at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Future self-learning AI model endpoint (leave empty until model is deployed)
NEXT_PUBLIC_AI_URL=
