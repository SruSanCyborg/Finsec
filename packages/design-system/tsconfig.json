{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "composite": true,
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@sirius/types": ["../../packages/types/src"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../types" }
  ]
}
