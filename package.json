{
  "name": "sirius-gui-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "SIRIUS Desktop Security Command Center GUI for finsec-lint",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @sirius/desktop dev",
    "build": "pnpm --filter \"@sirius/*\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --build --verbose",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\""
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@testing-library/react": "^16.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@eslint/js": "^9.20.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "typescript-eslint": "^8.24.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "happy-dom": "^17.1.8"
  }

}
